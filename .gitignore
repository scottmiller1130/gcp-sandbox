# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
.terraform.tfstate.lock.info

# Credentials - never commit these
*.json
!**/package.json

.DS_Store

# Terraform plan files
tfplan

# Saved plan output
plan.txt

# Modules are versioned by their callers; only root configs keep lock files
terraform/modules/**/.terraform.lock.hcl
